TINYIIOD ?= n

# Optional project-local build profile. This file uses Make syntax, for example:
#   FMCDAC_XSA := system_top.xsa
#   FMCDAC_AWG_PROFILE := scheduler-stream
#   FMCDAC_AWG_SCHED_BASEADDR := 0x44AA0000U
-include fmcdac_build.env

FMCDAC_XSA ?= system_top.xsa
HARDWARE := $(FMCDAC_XSA)
include ../../tools/scripts/generic_variables.mk

# On Windows, default to copying sources into the generated Xilinx app tree.
# The generic build defaults to LINK_SRCS=y, which uses mklink and fails on
# shells without symlink privilege, leaving build/app sources missing.
LINK_SRCS := n

# --- FMCDAC scheduler/stream build configuration ---

FMCDAC_AWG_PROFILE ?= default

FMCDAC_ENABLE_AWG_SCHED_CONSOLE ?= 0
FMCDAC_AWG_SCHED_STREAM ?= 0
FMCDAC_ENABLE_BENCHMARK_PROMPTS ?= 1
FMCDAC_ENABLE_SCHED_DET_SMOKETEST ?= 0
FMCDAC_DEFAULT_RATE_OPTION ?= 1
FMCDAC_AWG_SCHED_BASEADDR ?= 0x44AA0000U
FMCDAC_AWG_SCHED_MAX_EVENTS ?= 64U
FMCDAC_AWG_SCHED_TICK_HZ ?= 245760000U
FMCDAC_AWG_SCHED_DONE_TIMEOUT_MS ?= 2000U
FMCDAC_AWG_STREAM_CONSOLE_MAX_FRAME_EVENTS ?= 128U

ifeq ($(FMCDAC_AWG_PROFILE),scheduler-preload)
  FMCDAC_ENABLE_AWG_SCHED_CONSOLE := 1
  FMCDAC_AWG_SCHED_STREAM := 0
  FMCDAC_ENABLE_BENCHMARK_PROMPTS := 0
  FMCDAC_ENABLE_SCHED_DET_SMOKETEST := 0
endif

ifeq ($(FMCDAC_AWG_PROFILE),scheduler-stream)
  FMCDAC_ENABLE_AWG_SCHED_CONSOLE := 1
  FMCDAC_AWG_SCHED_STREAM := 1
  FMCDAC_ENABLE_BENCHMARK_PROMPTS := 0
  FMCDAC_ENABLE_SCHED_DET_SMOKETEST := 0
endif

FMCDAC_APP_CFLAGS += -DFMCDAC_ENABLE_AWG_SCHED_CONSOLE=$(FMCDAC_ENABLE_AWG_SCHED_CONSOLE)
FMCDAC_APP_CFLAGS += -DFMCDAC_AWG_SCHED_STREAM=$(FMCDAC_AWG_SCHED_STREAM)
FMCDAC_APP_CFLAGS += -DFMCDAC_ENABLE_BENCHMARK_PROMPTS=$(FMCDAC_ENABLE_BENCHMARK_PROMPTS)
FMCDAC_APP_CFLAGS += -DFMCDAC_ENABLE_SCHED_DET_SMOKETEST=$(FMCDAC_ENABLE_SCHED_DET_SMOKETEST)
FMCDAC_APP_CFLAGS += -DFMCDAC_DEFAULT_RATE_OPTION=$(FMCDAC_DEFAULT_RATE_OPTION)
FMCDAC_APP_CFLAGS += -DFMCDAC_AWG_SCHED_BASEADDR=$(FMCDAC_AWG_SCHED_BASEADDR)
FMCDAC_APP_CFLAGS += -DFMCDAC_AWG_SCHED_MAX_EVENTS=$(FMCDAC_AWG_SCHED_MAX_EVENTS)
FMCDAC_APP_CFLAGS += -DFMCDAC_AWG_SCHED_TICK_HZ=$(FMCDAC_AWG_SCHED_TICK_HZ)
FMCDAC_APP_CFLAGS += -DFMCDAC_AWG_SCHED_DONE_TIMEOUT_MS=$(FMCDAC_AWG_SCHED_DONE_TIMEOUT_MS)
FMCDAC_APP_CFLAGS += -DFMCDAC_AWG_STREAM_CONSOLE_MAX_FRAME_EVENTS=$(FMCDAC_AWG_STREAM_CONSOLE_MAX_FRAME_EVENTS)

FMCDAC_APP_CFLAG_PATTERNS := \
	-DFMCDAC_ENABLE_AWG_SCHED_CONSOLE=% \
	-DFMCDAC_AWG_SCHED_STREAM=% \
	-DFMCDAC_ENABLE_BENCHMARK_PROMPTS=% \
	-DFMCDAC_ENABLE_SCHED_DET_SMOKETEST=% \
	-DFMCDAC_DEFAULT_RATE_OPTION=% \
	-DFMCDAC_AWG_SCHED_BASEADDR=% \
	-DFMCDAC_AWG_SCHED_MAX_EVENTS=% \
	-DFMCDAC_AWG_SCHED_TICK_HZ=% \
	-DFMCDAC_AWG_SCHED_DONE_TIMEOUT_MS=% \
	-DFMCDAC_AWG_STREAM_CONSOLE_MAX_FRAME_EVENTS=%
NEW_CFLAGS := $(filter-out $(FMCDAC_APP_CFLAG_PATTERNS),$(NEW_CFLAGS)) $(FMCDAC_APP_CFLAGS)

include src.mk

include ../../tools/scripts/generic.mk

# --- S0 reproducibility targets ---

# Verify manifest before building (opt out with SKIP_MANIFEST=1)
ifneq ($(SKIP_MANIFEST),1)
  ifneq ($(wildcard manifest.json),)
.PHONY: manifest-verify
manifest-verify:
	@echo "[MANIFEST] Verifying build inputs..."
	@powershell -ExecutionPolicy Bypass -File gen_manifest.ps1 -Verify
build: manifest-verify
  endif
endif

# Generate / refresh the manifest
.PHONY: manifest-gen
manifest-gen:
	@powershell -ExecutionPolicy Bypass -File gen_manifest.ps1

# Verify a captured UART log against golden
.PHONY: verify-uart
verify-uart:
	@powershell -ExecutionPolicy Bypass -File verify_uart.ps1 \
		-LogFile $(or $(UART_LOG),captured_uart.txt) \
		-GoldenFile golden/uart_boot_log.txt

.PHONY: fmcdac-build-config scheduler-preload scheduler-stream

fmcdac-build-config:
	@echo FMCDAC_XSA=$(FMCDAC_XSA)
	@echo HARDWARE=$(HARDWARE)
	@echo FMCDAC_AWG_PROFILE=$(FMCDAC_AWG_PROFILE)
	@echo FMCDAC_ENABLE_AWG_SCHED_CONSOLE=$(FMCDAC_ENABLE_AWG_SCHED_CONSOLE)
	@echo FMCDAC_AWG_SCHED_STREAM=$(FMCDAC_AWG_SCHED_STREAM)
	@echo FMCDAC_ENABLE_BENCHMARK_PROMPTS=$(FMCDAC_ENABLE_BENCHMARK_PROMPTS)
	@echo FMCDAC_DEFAULT_RATE_OPTION=$(FMCDAC_DEFAULT_RATE_OPTION)
	@echo FMCDAC_AWG_SCHED_BASEADDR=$(FMCDAC_AWG_SCHED_BASEADDR)
	@echo FMCDAC_AWG_SCHED_MAX_EVENTS=$(FMCDAC_AWG_SCHED_MAX_EVENTS)
	@echo FMCDAC_AWG_SCHED_TICK_HZ=$(FMCDAC_AWG_SCHED_TICK_HZ)
	@echo FMCDAC_AWG_SCHED_DONE_TIMEOUT_MS=$(FMCDAC_AWG_SCHED_DONE_TIMEOUT_MS)
	@echo FMCDAC_AWG_STREAM_CONSOLE_MAX_FRAME_EVENTS=$(FMCDAC_AWG_STREAM_CONSOLE_MAX_FRAME_EVENTS)
	@echo FMCDAC_APP_CFLAGS=$(FMCDAC_APP_CFLAGS)
	@echo NEW_CFLAGS=$(NEW_CFLAGS)

scheduler-preload:
	$(MAKE) FMCDAC_AWG_PROFILE=scheduler-preload

scheduler-stream:
	$(MAKE) FMCDAC_AWG_PROFILE=scheduler-stream
