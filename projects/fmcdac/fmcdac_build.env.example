# Optional local FMCDAC build profile.
#
# To use:
#   Copy this file to fmcdac_build.env, edit as needed, then run make.
#   The Makefile includes fmcdac_build.env automatically when present.
#
# Supported profiles:
#   default             Normal firmware defaults.
#   scheduler-preload   AWG UART console enabled, stream disabled.
#   scheduler-stream    AWG UART console enabled, stream enabled.

# Hardware handoff. Override this to A/B boot archived XSAs without replacing
# system_top.xsa, for example system_top_bringup.xsa.
FMCDAC_XSA := system_top.xsa

FMCDAC_AWG_PROFILE := scheduler-stream
FMCDAC_DEFAULT_RATE_OPTION := 1

# Current KCU116 AWG scheduler base and timing defaults.
FMCDAC_AWG_SCHED_BASEADDR := 0x44AA0000U
FMCDAC_AWG_SCHED_MAX_EVENTS := 64U
FMCDAC_AWG_SCHED_TICK_HZ := 245760000U
FMCDAC_AWG_SCHED_DONE_TIMEOUT_MS := 2000U

# UARTLite STREAMHEX frame size. Keep this conservative at 115200 baud.
FMCDAC_AWG_STREAM_CONSOLE_MAX_FRAME_EVENTS := 128U
